# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001
CLIENT_URL=https://telogica-1.vercel.app

# ─── Database ────────────────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/telogica
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/telogica
MONGO_URI=mongodb+srv://bassnaidu_db_user:8zrWuVofg1yfpd5a@cluster0.srflrzn.mongodb.net


# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=3de4c8c3ae044597544b53e3292a147788b17d5600ff4596d574d9e913b9fec7f6c230e194ae33735cacf2ab5b13382d
JWT_EXPIRES_IN=7d
COOKIE_NAME=telogica_token

# ─── Seeded administrator ────────────────────────────────────────────────────
ADMIN_NAME=Telogica Admin
ADMIN_EMAIL=admin@telogica.com
ADMIN_PASSWORD=Admin@12345

# ─── Payments ────────────────────────────────────────────────────────────────
# Leave the Razorpay keys blank to run the built-in mock gateway (checkout still
# completes end to end, orders are marked paid). Add test keys from
# https://dashboard.razorpay.com/app/keys to exercise the real flow.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Storefront pricing ──────────────────────────────────────────────────────
TAX_RATE=0.18
FREE_SHIPPING_THRESHOLD=25000
SHIPPING_FLAT_RATE=750
CURRENCY=INR

# ─── Email (optional) ────────────────────────────────────────────────────────
# Without SMTP credentials, outgoing mail is logged to the server console
# instead of being sent — nothing breaks.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Telogica <no-reply@telogica.com>"
