# Copy to .env.local. Both values have working defaults for local development,
# so this file is only needed when the API runs somewhere else.

# Where the browser sends API calls. Same-origin by default: Next rewrites
# /api/* to the Express server (see next.config.mjs), so cookies just work.
NEXT_PUBLIC_API_URL=/api/v1

# Where Next's rewrite proxy forwards to, and where server components fetch from.
API_PROXY_TARGET=http://localhost:5001
API_INTERNAL_URL=http://localhost:5001/api/v1
